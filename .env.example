# Base de datos PostgreSQL
POSTGRES_DATABASE=gsys
POSTGRES_PASSWORD=change_me

# Usada por Prisma (apunta al contenedor postgres en Docker, o a Supabase en producción)
DATABASE_URL=postgresql://postgres:change_me@postgres:5432/gsys

# JWT
JWT_SECRET=change_me_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Redis (por defecto apunta al contenedor redis en Docker)
REDIS_HOST=redis
REDIS_PORT=6379

# Puerto de la aplicación
PORT=3000

# Entorno (development | production)
NODE_ENV=development

# Axiom (logs storage) — https://axiom.co
# Crear dataset en Axiom Dashboard → Datasets → New Dataset
# Crear token en Settings → API Tokens → New Token (permiso: Ingest)
AXIOM_TOKEN=xaat-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AXIOM_DATASET=gestion-backend
