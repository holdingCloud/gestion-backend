# Base de datos PostgreSQL
POSTGRES_DATABASE=gsys
POSTGRES_PASSWORD=change_me

# Usada por Prisma (apunta al contenedor postgres en Docker, o a Supabase en producción)
DATABASE_URL=postgresql://postgres:change_me@postgres:5432/gsys

# JWT
JWT_SECRET=change_me_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Redis (localhost para correr el backend fuera de Docker; dentro de Docker
# el servicio backend define REDIS_HOST=redis y esto no aplica)
REDIS_HOST=localhost
REDIS_PORT=6379

# Puerto de la aplicación
PORT=3000

# Entorno (development | production)
NODE_ENV=development
