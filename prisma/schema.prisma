// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexión de la app (puede ir por el pooler de Supabase, puerto 6543).
  url       = env("DATABASE_URL")
  // Conexión directa (puerto 5432). Prisma Migrate necesita advisory locks y
  // prepared statements que pgbouncer en modo transacción no soporta.
  directUrl = env("DIRECT_URL")
}

enum typePosition {
  SUPER_ADMIN
  ADMINISTRADOR
}

enum TiposDireccion {
  PRINCIPAL
  FACTURACION
  DESPACHO
  COMERCIAL
  TRABAJO
  SUCURSAL
  BODEGA
  OTRO
}

enum ContactStatus {
  LLAMAR
  CONTACTADO
  VENCIDO
  NUEVO
}

enum PurchaseStatus {
  PENDIENTE
  FINALIZADO
  ANULADO
}

enum FrequencyStatus {
  NUEVO
  EN_PLAZO
  POR_VENCER
  VENCIDO
}

// ─── Enums RRHH ───────────────────────────────────────────────────────────────

enum EstadoCivil {
  SOLTERO
  CASADO
  DIVORCIADO
  VIUDO
  CONVIVIENTE_CIVIL
}

enum Parentesco {
  CONYUGE
  HIJO
  PADRE
  MADRE
  OTRO
}

enum TipoCuentaBancaria {
  CUENTA_CORRIENTE
  CUENTA_VISTA
  CUENTA_AHORRO
}

enum TipoContrato {
  INDEFINIDO
  PLAZO_FIJO
  OBRA_O_FAENA
}

enum TipoGratificacion {
  ART_47
  ART_50
}

enum ContratoEstado {
  ACTIVO
  TERMINADO
  SUSPENDIDO
}

enum TipoItemLiquidacionEnum {
  HABER
  DESCUENTO
}

enum LiquidacionEstado {
  BORRADOR
  EMITIDA
  PAGADA
}

enum TipoVacaciones {
  LEGAL
  PROGRESIVA
  ADICIONAL
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoLicencia {
  ENFERMEDAD
  MATERNIDAD
  PATERNIDAD
  ACCIDENTE_LABORAL
  OTRO
}

enum EntidadLicencia {
  COMPIN
  ISAPRE
}

enum TipoPermiso {
  ADMINISTRATIVO
  SINDICAL
  OTRO
}

enum CausalFiniquito {
  ART_159_1
  ART_159_2
  ART_159_4
  ART_160
  ART_161
}

enum FiniquitoEstado {
  BORRADOR
  FIRMADO
  PAGADO
}

enum TipoDocEmpleado {
  CONTRATO
  CEDULA_IDENTIDAD
  CERTIFICADO_ESTUDIOS
  CERTIFICADO_AFP
  ANEXO
  FINIQUITO
  OTRO
}

model Users {
  id       Int      @id @default(autoincrement())
  fullName String   @db.VarChar(200)
  email    String   @unique @db.VarChar(30)
  password String   @db.VarChar(150)
  imagen   String   @db.VarChar(150)
  rol      Roles     @relation(fields: [rolesId], references: [id])
  rolesId  Int
  isActive Boolean @default(true)
  isLoged  Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Roles {
  id        Int         @id @default(autoincrement())
  type      String      @unique @db.VarChar(50)
  user      Users[]
  modulos   RolModulo[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum Modulo {
  DASHBOARD
  USUARIOS
  CLIENTES
  RRHH
  INVENTARIO
  COMPRAS
  PROVEEDORES
  CUENTAS
  HOJA_DE_VENTA
  REPORTES
  EMPRESAS
}

model RolModulo {
  id        Int      @id @default(autoincrement())
  rolId     Int
  modulo    Modulo
  rol       Roles    @relation(fields: [rolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([rolId, modulo])
  @@index([rolId])
}

model Products {
  id                       Int                      @id @default(autoincrement())
  name                     String                   @db.VarChar(25)
  description              String                   @db.VarChar(50)
  quantity                 Int
  available                Boolean                  @default(true)
  img                      String                   @db.VarChar(50)
  code                     String                   @db.VarChar(50)
  detailsSalesSheets       detailsSalesSheet[]
  buysByClient             buyByClient[]
  clientProductFrequencies ClientProductFrequency[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([available])
}

model Region {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  communes  Commune[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Commune {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(100)
  region      Region        @relation(fields: [regionId], references: [id])
  regionId    Int
  direcciones Direcciones[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Direcciones {
  id           Int            @id @default(autoincrement())
  tipo         TiposDireccion
  calle        String         @db.VarChar(200)
  numero       String?        @db.VarChar(20)
  departamento String?        @db.VarChar(50)
  referencia   String?        @db.VarChar(200)
  commune      Commune?       @relation(fields: [communeId], references: [id])
  communeId    Int?
  latitud      Decimal?       @db.Decimal(10, 8)
  longitud     Decimal?       @db.Decimal(11, 8)
  client       Clients?
  employee     Employees?
  company      Company?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([communeId])
  @@index([tipo])
}

model Company {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(150)
  description String?      @db.VarChar(500)
  clients     Clients[]
  direccionId Int?         @unique
  direccion   Direcciones? @relation(fields: [direccionId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Clients {
  id                       Int                      @id @default(autoincrement())
  fullname                 String                   @db.VarChar(150)
  phone                    String                   @db.VarChar(15)
  phone2                   String?                  @db.VarChar(15)
  email                    String?                  @db.VarChar(100)
  company                  Company?                 @relation(fields: [companyId], references: [id])
  companyId                Int?
  direccionId              Int?                     @unique
  direccion                Direcciones?             @relation(fields: [direccionId], references: [id])
  detailsSalesSheets       detailsSalesSheet[]
  buysByClient             buyByClient[]
  clientProductFrequencies ClientProductFrequency[]
  available                Boolean                  @default(true)
  contactStatus            ContactStatus            @default(NUEVO)
  contactStatusLockedUntil DateTime?
  frequency                Int?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([available])
  @@index([companyId])
  @@index([createdAt])
}

model buyByClient {
  id             Int            @id @default(autoincrement())
  client         Clients        @relation(fields: [clientsId], references: [id])
  clientsId      Int
  product        Products       @relation(fields: [productsId], references: [id])
  productsId     Int
  quantity       Int
  unitPrice      Float
  purchaseDate   DateTime?
  purchaseStatus PurchaseStatus @default(PENDIENTE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([clientsId, productsId])
  @@index([clientsId, createdAt])
  @@index([purchaseDate])
}

model ClientProductFrequency {
  id                      Int             @id @default(autoincrement())
  client                  Clients         @relation(fields: [clientsId], references: [id])
  clientsId               Int
  product                 Products        @relation(fields: [productsId], references: [id])
  productsId              Int
  purchaseCount           Int             @default(0)
  avgDaysBetweenPurchases Int?
  lastPurchaseDate        DateTime?
  actualPurchaseDate      DateTime?
  nextEstimatedDate       DateTime?
  status                  FrequencyStatus @default(NUEVO)
  updatedAt               DateTime        @updatedAt

  @@unique([clientsId, productsId])
  @@index([nextEstimatedDate])
  @@index([status])
  @@index([actualPurchaseDate])
  @@index([clientsId, status])
}

// ─── RRHH: Catálogos ──────────────────────────────────────────────────────────

model Departamentos {
  id        Int         @id @default(autoincrement())
  nombre    String      @db.VarChar(100)
  cargos    Cargos[]
  employees Employees[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Cargos {
  id             Int           @id @default(autoincrement())
  nombre         String        @db.VarChar(100)
  departamento   Departamentos @relation(fields: [departamentoId], references: [id])
  departamentoId Int
  employees      Employees[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([departamentoId])
}

model AFP {
  id             Int         @id @default(autoincrement())
  nombre         String      @db.VarChar(100)
  tasaCotizacion Decimal     @db.Decimal(5, 4)
  employees      Employees[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model SistemasSalud {
  id        Int         @id @default(autoincrement())
  tipo      String      @db.VarChar(50)
  nombre    String      @db.VarChar(100)
  employees Employees[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Mutuales {
  id        Int         @id @default(autoincrement())
  nombre    String      @db.VarChar(100)
  employees Employees[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model TiposItemLiquidacion {
  id               Int                      @id @default(autoincrement())
  nombre           String                   @db.VarChar(100)
  tipo             TipoItemLiquidacionEnum
  esLegal          Boolean                  @default(false)
  itemsLiquidacion ItemsLiquidacion[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

// ─── RRHH: Empleados ──────────────────────────────────────────────────────────

model Employees {
  id              Int            @id @default(autoincrement())
  rut             String         @db.VarChar(20)
  fullname        String         @db.VarChar(150)
  email           String         @db.VarChar(100)
  salary          Int
  hireDate        DateTime       @db.Date
  available       Boolean        @default(true)
  type            typePosition   @default(ADMINISTRADOR)
  fechaNacimiento DateTime?      @db.Date
  estadoCivil     EstadoCivil?
  cargoId         Int?
  cargo           Cargos?        @relation(fields: [cargoId], references: [id])
  departamentoId  Int?
  departamento    Departamentos? @relation(fields: [departamentoId], references: [id])
  afpId           Int?
  afp             AFP?           @relation(fields: [afpId], references: [id])
  sistemasSaludId Int?
  sistemasSalud   SistemasSalud? @relation(fields: [sistemasSaludId], references: [id])
  mutualId        Int?
  mutual          Mutuales?      @relation(fields: [mutualId], references: [id])
  jefeId          Int?
  jefe            Employees?     @relation("JefeSubordinado", fields: [jefeId], references: [id])
  subordinados    Employees[]    @relation("JefeSubordinado")
  salesSheets     salesSheets[]
  cargasFamiliares      CargasFamiliares[]
  cuentasBancarias      CuentasBancariasEmpleado[]
  contratos             Contratos[]
  liquidaciones         Liquidaciones[]
  anticipos             Anticipos[]
  solicitudesVacaciones SolicitudesVacaciones[]
  licenciasMedicas      LicenciasMedicas[]
  permisos              Permisos[]
  finiquitos            Finiquitos[]
  documentos            DocumentosEmpleado[]
  libroRemuneraciones   LibroRemuneraciones[]
  direccionId     Int?           @unique
  direccion       Direcciones?   @relation(fields: [direccionId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([available])
  @@index([cargoId])
  @@index([departamentoId])
}

// ─── RRHH: Accesorios del empleado ───────────────────────────────────────────

model CargasFamiliares {
  id              Int        @id @default(autoincrement())
  employee        Employees  @relation(fields: [employeeId], references: [id])
  employeeId      Int
  rut             String     @db.VarChar(20)
  nombre          String     @db.VarChar(150)
  parentesco      Parentesco
  fechaNacimiento DateTime   @db.Date
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([employeeId])
}

model CuentasBancariasEmpleado {
  id           Int                @id @default(autoincrement())
  employee     Employees          @relation(fields: [employeeId], references: [id])
  employeeId   Int
  banco        String             @db.VarChar(100)
  tipoCuenta   TipoCuentaBancaria
  numeroCuenta String             @db.VarChar(30)
  esPrincipal  Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([employeeId])
}

// ─── RRHH: Contratos ─────────────────────────────────────────────────────────

model Contratos {
  id            Int               @id @default(autoincrement())
  employee      Employees         @relation(fields: [employeeId], references: [id])
  employeeId    Int
  tipoContrato  TipoContrato
  sueldoBase    Decimal           @db.Decimal(10, 2)
  gratificacion TipoGratificacion
  jornada       Int
  fechaInicio   DateTime          @db.Date
  fechaTermino  DateTime?         @db.Date
  estado        ContratoEstado    @default(ACTIVO)
  anexos        AnexosContrato[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([employeeId])
  @@index([estado])
}

model AnexosContrato {
  id            Int       @id @default(autoincrement())
  contrato      Contratos @relation(fields: [contratoId], references: [id])
  contratoId    Int
  descripcion   String    @db.Text
  fechaVigencia DateTime  @db.Date
  urlDocumento  String?   @db.VarChar(300)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([contratoId])
}

// ─── RRHH: Liquidaciones ─────────────────────────────────────────────────────

model Liquidaciones {
  id              Int               @id @default(autoincrement())
  employee        Employees         @relation(fields: [employeeId], references: [id])
  employeeId      Int
  periodo         DateTime          @db.Date
  sueldoBase      Decimal           @db.Decimal(10, 2)
  totalHaberes    Decimal           @db.Decimal(12, 2)
  totalDescuentos Decimal           @db.Decimal(12, 2)
  liquidoAPagar   Decimal           @db.Decimal(12, 2)
  estado          LiquidacionEstado @default(BORRADOR)
  items           ItemsLiquidacion[]
  libroRemuneraciones LibroRemuneraciones[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([employeeId, periodo])
  @@index([periodo])
  @@index([estado])
}

model ItemsLiquidacion {
  id            Int                  @id @default(autoincrement())
  liquidacion   Liquidaciones        @relation(fields: [liquidacionId], references: [id])
  liquidacionId Int
  tipoItem      TiposItemLiquidacion @relation(fields: [tipoItemId], references: [id])
  tipoItemId    Int
  monto         Decimal              @db.Decimal(10, 2)
  createdAt     DateTime             @default(now())

  @@index([liquidacionId])
}

model LibroRemuneraciones {
  id             Int           @id @default(autoincrement())
  periodo        DateTime      @db.Date
  employee       Employees     @relation(fields: [employeeId], references: [id])
  employeeId     Int
  liquidacion    Liquidaciones @relation(fields: [liquidacionId], references: [id])
  liquidacionId  Int
  totalImponible Decimal       @db.Decimal(12, 2)
  liquido        Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())

  @@unique([employeeId, periodo])
  @@index([periodo])
}

// ─── RRHH: Anticipos ─────────────────────────────────────────────────────────

model Anticipos {
  id         Int       @id @default(autoincrement())
  employee   Employees @relation(fields: [employeeId], references: [id])
  employeeId Int
  monto      Decimal   @db.Decimal(10, 2)
  fecha      DateTime  @db.Date
  descontado Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([employeeId])
  @@index([descontado])
}

// ─── RRHH: Ausencias ─────────────────────────────────────────────────────────

model SolicitudesVacaciones {
  id          Int             @id @default(autoincrement())
  employee    Employees       @relation(fields: [employeeId], references: [id])
  employeeId  Int
  tipo        TipoVacaciones
  fechaInicio DateTime        @db.Date
  fechaFin    DateTime        @db.Date
  diasHabiles Int
  estado      EstadoSolicitud @default(PENDIENTE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([employeeId])
  @@index([estado])
}

model LicenciasMedicas {
  id           Int             @id @default(autoincrement())
  employee     Employees       @relation(fields: [employeeId], references: [id])
  employeeId   Int
  tipo         TipoLicencia
  entidad      EntidadLicencia
  fechaInicio  DateTime        @db.Date
  fechaFin     DateTime        @db.Date
  dias         Int
  urlDocumento String?         @db.VarChar(300)
  estado       EstadoSolicitud @default(PENDIENTE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([employeeId])
  @@index([estado])
}

model Permisos {
  id          Int             @id @default(autoincrement())
  employee    Employees       @relation(fields: [employeeId], references: [id])
  employeeId  Int
  tipo        TipoPermiso
  conGoce     Boolean         @default(true)
  fechaInicio DateTime        @db.Date
  fechaFin    DateTime        @db.Date
  motivo      String?         @db.Text
  estado      EstadoSolicitud @default(PENDIENTE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([employeeId])
}

// ─── RRHH: Finiquitos ────────────────────────────────────────────────────────

model Finiquitos {
  id                  Int             @id @default(autoincrement())
  employee            Employees       @relation(fields: [employeeId], references: [id])
  employeeId          Int
  causal              CausalFiniquito
  fechaTermino        DateTime        @db.Date
  feriadoProporcional Decimal         @db.Decimal(10, 2)
  indemnizacion       Decimal         @db.Decimal(10, 2)
  totalFiniquito      Decimal         @db.Decimal(12, 2)
  estado              FiniquitoEstado @default(BORRADOR)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([employeeId])
}

// ─── RRHH: Documentos del empleado ───────────────────────────────────────────

model DocumentosEmpleado {
  id         Int             @id @default(autoincrement())
  employee   Employees       @relation(fields: [employeeId], references: [id])
  employeeId Int
  tipo       TipoDocEmpleado
  url        String          @db.VarChar(300)
  nombre     String          @db.VarChar(150)
  createdAt  DateTime        @default(now())

  @@index([employeeId])
}

model Bills {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(50)
  details     BillDetails[]
  salesSheets salesSheets[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model BillDetails {
  id        Int      @id @default(autoincrement())
  amount    Int
  date      DateTime
  bill      Bills    @relation(fields: [billsId], references: [id])
  billsId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model salesSheets {
  id                Int                 @id @default(autoincrement())
  employee          Employees           @relation(fields: [employeeId], references: [id])
  employeeId        Int
  date              DateTime
  description       String              @db.Text
  bill              Bills               @relation(fields: [billId], references: [id])
  billId            Int
  detailsSalesSheet detailsSalesSheet[]
}

model detailsSalesSheet {
  id           Int         @id @default(autoincrement())
  client       Clients     @relation(fields: [clientsId], references: [id])
  clientsId    Int
  product      Products    @relation(fields: [productsId], references: [id])
  productsId   Int
  quantity     Int
  discount     Float
  salesSheet   salesSheets @relation(fields: [salesSheetId], references: [id])
  salesSheetId Int
}